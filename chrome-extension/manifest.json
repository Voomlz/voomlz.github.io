{
  "name": "WCL Threat Link",
  "description": "Link Warcraft logs to TBCC threat graph",
  "version": "1.6",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": ["*://*.classic.warcraftlogs.com/reports/*"],
      "js": ["addButton.js"]
    },
    {
      "matches": ["*://*.vanilla.warcraftlogs.com/reports/*"],
      "js": ["addButtonEra.js"]
    },
    {
      "matches": [
        "*://*.vanilla.warcraftlogs.com/reports/*",
        "*://*.classic.warcraftlogs.com/reports/*",
        "*://*.warcraftlogs.com/reports/*"
      ],
      "js": ["critToggle.js"]
    }
  ]
}